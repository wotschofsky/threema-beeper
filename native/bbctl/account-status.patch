+func TestLocalBridgeStatusSpoolSurvivesRestartAndLostLocalResponse(t *testing.T) {
+	root, _ := filepath.EvalSymlinks(t.TempDir())
+	dir := filepath.Join(root, "queue")
+	spool, err := openTransactionSpool(dir, "synthetic-secret")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second, e := openTransactionSpool(dir, "synthetic-secret"); e == nil {
+		second.Close()
+		t.Fatal("allowed concurrent queue owner")
+	}
+	var msg appservice.WebsocketMessage
+	if err = json.Unmarshal([]byte(`{"txn_id":"remote-range","events":[{"type":"m.room.encrypted","event_id":"$fixture","content":{"ciphertext":"synthetic private payload"}}]}`), &msg); err != nil {
+		t.Fatal(err)
+	}
+	if err = spool.save(msg); err != nil {
+		t.Fatal(err)
+	}
+	entries, _ := os.ReadDir(dir)
+	var filename string
+	for _, e := range entries {
+		if strings.HasSuffix(e.Name(), ".txn") {
+			filename = filepath.Join(dir, e.Name())
+		}
+	}
+	disk, _ := os.ReadFile(filename)
+	if bytes.Contains(disk, []byte("synthetic private")) {
+		t.Fatal("plaintext transaction on disk")
+	}
+	var ids []string
+	send := func(_ context.Context, m appservice.WebsocketMessage) error {
+		ids = append(ids, m.TxnID)
+		if len(m.Events) != 1 {
+			t.Fatal("lost queued event")
+		}
+		if len(ids) == 1 {
+			return errors.New("lost local response")
+		}
+		return nil
+	}
+	if err = spool.replay(context.Background(), send); err == nil {
+		t.Fatal("expected failed delivery")
+	}
+	spool.Close()
+	wrong, e := openTransactionSpool(dir, "wrong-secret")
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = wrong.replay(context.Background(), send); e == nil {
+		t.Fatal("wrong key accepted")
+	}
+	wrong.Close()
+	spool, e = openTransactionSpool(dir, "synthetic-secret")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer spool.Close()
+	if e = spool.replay(context.Background(), send); e != nil {
+		t.Fatal(e)
+	}
+	if len(ids) != 2 || ids[0] != ids[1] {
+		t.Fatal("local idempotency identity changed")
+	}
+	if e = spool.replay(context.Background(), send); e != nil || len(ids) != 2 {
+		t.Fatal("settled queue replayed")
+	}
+	if e = spool.save(msg); e != nil {
+		t.Fatal(e)
+	}
+	entries, _ = os.ReadDir(dir)
+	for _, entry := range entries {
+		if strings.HasSuffix(entry.Name(), ".txn") {
+			path := filepath.Join(dir, entry.Name())
+			data, _ := os.ReadFile(path)
+			data[len(data)-1] ^= 1
+			_ = os.WriteFile(path, data, 0600)
+		}
+	}
+	if e = spool.replay(context.Background(), send); e == nil {
+		t.Fatal("corrupted queue accepted")
+	}
+}
diff --git a/cmd/bbctl/proxy_spool.go b/cmd/bbctl/proxy_spool.go
new file mode 100644
--- /dev/null
+++ b/cmd/bbctl/proxy_spool.go
@@ -0,0 +1,194 @@
+package main
+
+import (
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"maunium.net/go/mautrix/appservice"
+)
+
+// Transactions are acknowledged only after authenticated encryption, file fsync,
+// atomic publication and directory fsync. The local inbox remains idempotent.
+type transactionSpool struct {
+	dir  string
+	aead cipher.AEAD
+	lock *os.File
+	mu   sync.Mutex
+}
+
+const spoolLimit = 50 * 1024 * 1024
+
+func openTransactionSpool(dir, token string) (*transactionSpool, error) {
+	if !filepath.IsAbs(dir) || token == "" {
+		return nil, errors.New("invalid spool configuration")
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, err
+	}
+	real, err := filepath.EvalSymlinks(dir)
+	if err != nil || real != dir {
+		return nil, errors.New("spool path must be real")
+	}
+	stat, err := os.Stat(dir)
+	if err != nil || !stat.IsDir() || stat.Mode().Perm() != 0700 || stat.Sys().(*syscall.Stat_t).Uid != uint32(os.Getuid()) {
+		return nil, errors.New("spool must be private and owned")
+	}
+	fd, err := syscall.Open(filepath.Join(dir, ".lock"), syscall.O_CREAT|syscall.O_RDWR|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, err
+	}
+	lock := os.NewFile(uintptr(fd), "spool-lock")
+	if err = syscall.Flock(fd, syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		lock.Close()
+		return nil, errors.New("spool already open")
+	}
+	key := sha256.Sum256([]byte("threema-beeper transaction spool v1\x00" + token))
+	block, err := aes.NewCipher(key[:])
+	clear(key[:])
+	if err != nil {
+		lock.Close()
+		return nil, err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		lock.Close()
+		return nil, err
+	}
+	return &transactionSpool{dir: dir, aead: aead, lock: lock}, nil
+}
+func (s *transactionSpool) Close() { _ = s.lock.Close() }
+func (s *transactionSpool) syncDir() error {
+	f, err := os.Open(s.dir)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return f.Sync()
+}
+func (s *transactionSpool) save(msg appservice.WebsocketMessage) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	body, err := json.Marshal(msg)
+	if err != nil || len(body) > spoolLimit {
+		return errors.New("transaction exceeds spool limit")
+	}
+	defer clear(body)
+	entries, err := os.ReadDir(s.dir)
+	if err != nil {
+		return err
+	}
+	var total int64
+	count := 0
+	for _, entry := range entries {
+		if strings.HasSuffix(entry.Name(), ".txn") {
+			info, e := entry.Info()
+			if e != nil {
+				return e
+			}
+			total += info.Size()
+			count++
+		}
+	}
+	if count >= 10000 || total+int64(len(body)) > 1024*1024*1024 {
+		return errors.New("transaction spool full")
+	}
+	nonce := make([]byte, s.aead.NonceSize())
+	if _, err = rand.Read(nonce); err != nil {
+		return err
+	}
+	name := fmt.Sprintf("%020d-%s.txn", time.Now().UnixNano(), hex.EncodeToString(nonce))
+	sealed := s.aead.Seal(nonce, nonce, body, []byte(name))
+	f, err := os.CreateTemp(s.dir, ".pending-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(sealed); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	if err = os.Rename(f.Name(), filepath.Join(s.dir, name)); err != nil {
+		return err
+	}
+	return s.syncDir()
+}
+func (s *transactionSpool) replay(ctx context.Context, send func(context.Context, appservice.WebsocketMessage) error) error {
+	entries, err := os.ReadDir(s.dir)
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".txn") {
+			continue
+		}
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+		path := filepath.Join(s.dir, entry.Name())
+		info, e := os.Lstat(path)
+		if e != nil {
+			return e
+		}
+		if !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > spoolLimit+128 {
+			return errors.New("invalid spool file")
+		}
+		f, e := os.Open(path)
+		if e != nil {
+			return e
+		}
+		sealed, e := io.ReadAll(io.LimitReader(f, spoolLimit+129))
+		f.Close()
+		if e != nil {
+			return e
+		}
+		n := s.aead.NonceSize()
+		if len(sealed) < n {
+			return errors.New("invalid spool ciphertext")
+		}
+		body, e := s.aead.Open(nil, sealed[:n], sealed[n:], []byte(entry.Name()))
+		if e != nil {
+			return errors.New("spool authentication failed")
+		}
+		var msg appservice.WebsocketMessage
+		e = json.Unmarshal(body, &msg)
+		digest := sha256.Sum256(body)
+		clear(body)
+		if e != nil {
+			return errors.New("invalid spooled transaction")
+		}
+		// Payload hashes avoid collisions when the remote replay keeps a transaction
+		// range ID but has already discarded its expired event payload.
+		msg.TxnID = "spool_" + hex.EncodeToString(digest[:])
+		if err = send(ctx, msg); err != nil {
+			return err
+		}
+		if err = os.Remove(path); err != nil {
+			return err
+		}
+		if err = s.syncDir(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
