+)
+
+func TestLocalBridgeStatus(t *testing.T) {
+	payload := `[{"state_event":"RUNNING","ttl":90},{"state_event":"CONNECTED","ttl":90,"remote_id":"TEST1234","user_id":"@owner:example.invalid"}]`
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "GET" || r.URL.Path != "/_threema/bridge-state" || r.Header.Get("Authorization") != "Bearer synthetic-token" {
+			t.Error("invalid authenticated status request")
+		}
+		fmt.Fprint(w, payload)
+	}))
+	defer srv.Close()
+	states, err := readLocalBridgeStatus(context.Background(), srv.URL, "synthetic-token")
+	if err != nil || len(states) != 2 {
+		t.Fatalf("valid status failed: %v", err)
+	}
+	for _, invalid := range []string{`[]`, `[{}]`, `[{"state_event":"RUNNING","ttl":90},{"state_event":"CONNECTED","ttl":9999,"remote_id":"TEST1234","user_id":"@owner:example.invalid"}]`} {
+		payload = invalid
+		if _, err := readLocalBridgeStatus(context.Background(), srv.URL, "synthetic-token"); err == nil {
+			t.Error("invalid state accepted")
+		}
+	}
+	if _, err := readLocalBridgeStatus(context.Background(), "https://example.invalid", "synthetic-token"); err == nil {
+		t.Error("non-loopback URL accepted")
+	}
+}
+
+func TestLocalBridgeStatusNoRedirect(t *testing.T) {
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("followed redirect with status credentials") }))
+	defer target.Close()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Redirect(w, r, target.URL, http.StatusFound) }))
+	defer srv.Close()
+	if _, err := readLocalBridgeStatus(context.Background(), srv.URL, "synthetic-token"); err == nil {
+		t.Error("redirect accepted")
+	}
+}
+
+func TestLocalBridgeStatusTransactionFailureClosesWithoutAcknowledgement(t *testing.T) {
+	for _, available := range []bool{false, true} {
+		t.Run(fmt.Sprint(available), func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			local := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != "PUT" || r.Header.Get("Authorization") != "Bearer synthetic-server" {
+					t.Error("invalid transaction forwarding")
+				}
+				if !available {
+					w.WriteHeader(503)
+					fmt.Fprint(w, `{"errcode":"M_UNAVAILABLE","error":"offline"}`)
+					return
+				}
+				fmt.Fprint(w, `{}`)
+			}))
+			defer local.Close()
+			checked := make(chan bool, 1)
+			remote := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				ws, err := websocket.Accept(w, r, nil)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				defer ws.CloseNow()
+				if err = wsjson.Write(ctx, ws, map[string]any{"id": 1, "command": "transaction", "txn_id": "stable-test-id", "events": []any{}}); err != nil {
+					t.Error(err)
+					return
+				}
+				var response appservice.WebsocketRequest
+				err = wsjson.Read(ctx, ws, &response)
+				checked <- (available && err == nil && response.Command == "response") || (!available && err != nil)
+			}))
+			defer remote.Close()
+			as := appservice.Create()
+			as.Registration = &appservice.Registration{AppToken: "synthetic-app", ServerToken: "synthetic-server", SenderLocalpart: "bot"}
+			as.HomeserverDomain = "example.invalid"
+			if err := as.SetHomeserverURL(remote.URL); err != nil {
+				t.Fatal(err)
+			}
+			parsed, _ := url.Parse(local.URL)
+			as.WebsocketTransactionHandler = localTransactionHandler(as, parsed)
+			done := make(chan struct{})
+			go func() { _ = as.StartWebsocket(ctx, remote.URL, nil); close(done) }()
+			select {
+			case ok := <-checked:
+				if !ok {
+					t.Fatal("transaction response did not match durable availability")
+				}
+			case <-ctx.Done():
+				t.Fatal("timed out")
+			}
+			select {
+			case <-done:
+			case <-ctx.Done():
+				t.Fatal("socket did not close")
+			}
+		})
+	}
+}
