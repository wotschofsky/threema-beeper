# Candidate source-built runtime; final release acceptance remains pending.
FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ patch xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY node-v24.21.0.tar.xz cleanup-hooks.patch ./
RUN echo "a6f54defb6fd7c84f41dba13d61e78e9b4e0961712cf61f29715c05f5ced94fc  node-v24.21.0.tar.xz" | sha256sum -c - \
    && echo "d81bb3d1a3558df9a32b7af7db9806e0ff26d2fa38bb41ca321f16baa78b9551  cleanup-hooks.patch" | sha256sum -c - \
    && tar -xJf node-v24.21.0.tar.xz \
    && cd node-v24.21.0 && patch --batch --fuzz=0 -p1 < ../cleanup-hooks.patch
WORKDIR /build/node-v24.21.0
RUN ./configure --prefix=/opt/node-cleanup && make -j4 && make install
RUN out/Release/cctest --gtest_filter='EnvironmentTest.RemoveEnvironmentCleanupHookDuringCleanup' \
      --gtest_list_tests > /tmp/cleanup-tests.txt \
    && grep -Fx '  RemoveEnvironmentCleanupHookDuringCleanup' /tmp/cleanup-tests.txt \
    && out/Release/cctest --gtest_filter='EnvironmentTest.RemoveEnvironmentCleanupHookDuringCleanup'
RUN cd test/addons/worker-addon \
    && /opt/node-cleanup/bin/node ../../../deps/npm/node_modules/node-gyp/bin/node-gyp.js \
       rebuild --release --nodedir=/opt/node-cleanup \
    && /opt/node-cleanup/bin/node test.js
FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS node-runtime
COPY --from=build /opt/node-cleanup/ /usr/local/
RUN node -p 'JSON.stringify(process.versions)'

# Experimental service and probe targets; release source-build provenance is incomplete.
FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS inputs
WORKDIR /probe
COPY . .
RUN node scripts/entry.verify-linux-context.ts /probe

FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS codec-builder
RUN apt-get update && apt-get install -y --no-install-recommends make gcc g++ nasm pkg-config xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=inputs /probe/.artifacts/ffmpeg/ffmpeg-8.0.3.tar.xz /inputs/ffmpeg-8.0.3.tar.xz
COPY --from=inputs /probe/docs/FFMPEG-PINS.json /inputs/FFMPEG-PINS.json
COPY --from=inputs /probe/native/build-ffmpeg.sh /inputs/build-ffmpeg.sh
COPY --from=inputs /probe/.artifacts/opus/opus-1.6.1.tar.gz /inputs/opus-1.6.1.tar.gz
COPY --from=inputs /probe/docs/OPUS-PINS.json /inputs/OPUS-PINS.json
COPY --from=inputs /probe/native/build-opus.sh /inputs/build-opus.sh
RUN sh /inputs/build-opus.sh
COPY --from=inputs /probe/.artifacts/openh264/openh264-2.6.0.tar.gz /inputs/openh264-2.6.0.tar.gz
COPY --from=inputs /probe/docs/OPENH264-PINS.json /inputs/OPENH264-PINS.json
COPY --from=inputs /probe/native/build-openh264.sh /inputs/build-openh264.sh
RUN sh /inputs/build-openh264.sh
RUN sh /inputs/build-ffmpeg.sh

FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS codec
COPY --from=codec-builder /codec/bin/ /usr/bin/
COPY --from=codec-builder /codec/share/ffmpeg/ /usr/share/ffmpeg/
COPY --from=codec-builder /codec/share/opus/ /usr/share/opus/
COPY --from=codec-builder /codec/share/openh264/ /usr/share/openh264/
USER 1000:1000

FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS jpeg-builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev cmake ninja-build nasm \
    && rm -rf /var/lib/apt/lists/*
COPY --from=inputs /probe/.artifacts/jpeg/libjpeg-turbo-3.2.0.tar.gz /inputs/libjpeg-turbo-3.2.0.tar.gz
COPY --from=inputs /probe/docs/JPEG-PINS.json /probe/native/jpeg-encode.c /probe/native/jpeg-srgb-profile.h /probe/native/build-jpeg.sh /inputs/
RUN sh /inputs/build-jpeg.sh

FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS webp-builder
RUN apt-get update && apt-get install -y --no-install-recommends make gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=inputs /probe/.artifacts/webp/libwebp-1.6.0.tar.gz /inputs/libwebp-1.6.0.tar.gz
COPY --from=inputs /probe/docs/WEBP-PINS.json /inputs/WEBP-PINS.json
COPY --from=inputs /probe/native/webp-first-frame.c /inputs/webp-first-frame.c
COPY --from=inputs /probe/native/build-webp.sh /inputs/build-webp.sh
RUN sh /inputs/build-webp.sh

FROM node:24.21.0-trixie-slim@sha256:db3ae80f5d8df06e04dabdf7b44cbf008d32de168205fa0294444aabbc08c590 AS avif-builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev cmake meson ninja-build nasm pkg-config xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=inputs /probe/.artifacts/avif/ /inputs/
COPY --from=inputs /probe/docs/AVIF-PINS.json /probe/docs/DAV1D-PINS.json /probe/docs/LCMS-PINS.json /inputs/
COPY --from=inputs /probe/native/avif-first-frame.c /probe/native/build-avif.sh /inputs/
RUN sh /inputs/build-avif.sh

FROM node-runtime AS builder
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /probe
COPY --from=inputs /probe/.local/sources/threema-desktop/ .local/sources/threema-desktop/
COPY --from=inputs /probe/native-build.json ./
COPY --from=inputs /probe/native/media-limits.c /tmp/media-limits.c
RUN cc -O2 -Wall -Wextra -Werror /tmp/media-limits.c -o /usr/local/bin/media-limits
RUN node --input-type=module -e '\
    import {readFileSync} from "node:fs"; \
    import {execFileSync} from "node:child_process"; \
    import {resolve} from "node:path"; \
    const manifest = JSON.parse(readFileSync("native-build.json", "utf8")); \
    for (const name of ["better-sqlcipher", "argon2"]) { \
      const pkg = manifest.packages.find(p => p.name === name); \
      execFileSync(process.execPath, [resolve(manifest.nodeGyp), "rebuild", "--release", "-j", "4", "--nodedir=/usr/local"], \
        {cwd: pkg.path, stdio: "inherit"}); \
    }'
COPY --from=inputs /probe/scripts/entry.prepare-linux-artifacts.ts scripts/
RUN node scripts/entry.prepare-linux-artifacts.ts native

FROM inputs AS runtime-inputs
RUN node scripts/entry.prepare-linux-artifacts.ts runtime

FROM node-runtime AS runtime-base
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends tini ca-certificates file zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
WORKDIR /probe
COPY --from=runtime-inputs /runtime /probe
COPY --from=builder /native /probe
COPY --from=builder /usr/local/bin/media-limits /usr/local/bin/media-limits
COPY --from=jpeg-builder /jpeg/bin/jpeg-encode /usr/local/bin/jpeg-encode
COPY --from=jpeg-builder /jpeg/share/ /usr/share/
COPY --from=codec-builder /codec/bin/ /usr/bin/
COPY --from=codec-builder /codec/share/ffmpeg/ /usr/share/ffmpeg/
COPY --from=codec-builder /codec/share/opus/ /usr/share/opus/
COPY --from=codec-builder /codec/share/openh264/ /usr/share/openh264/
COPY --from=webp-builder /webp/bin/webp-first-frame /usr/local/bin/webp-first-frame
COPY --from=webp-builder /webp/share/webp/ /usr/share/webp/
COPY --from=avif-builder /avif/bin/avif-first-frame /usr/local/bin/avif-first-frame
COPY --from=avif-builder /avif/share/ /usr/share/
COPY --from=runtime-inputs /runtime-bin/bbctl /usr/local/bin/bbctl
RUN mkdir -p /app \
    && ln -s /probe/.local/wasm-web/libthreema_bg.wasm /app/libthreema_bg.wasm
USER 1000:1000

FROM runtime-base AS service
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "node", "src/service/entry.service.ts"]
CMD ["/config/bridge.yaml"]

FROM runtime-base AS probe
CMD ["node", "--test", "tests/probes/entry.native-persistence-probe.ts", "tests/probes/entry.matrix-native-persistence-probe.ts", "tests/probes/entry.matrix-device-exchange-probe.ts", "tests/probes/entry.headless-lifecycle-probe.ts", "tests/entry.backend-controller.ts", "tests/entry.service-start.ts", "tests/entry.service-resources.ts", "tests/entry.matrix-session.ts"]
