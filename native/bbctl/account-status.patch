+// Failure to read local status must not keep publishing a stale CONNECTED state.
+// Its short TTL lets the server expire the last known state if this process fails.
+func forwardLocalBridgeStatus(ctx context.Context, as *appservice.AppService) {
+	states, err := readLocalBridgeStatus(ctx, as.Registration.URL, as.Registration.ServerToken)
+	if err != nil {
+		as.Log.Warn().Msg("Local bridge account status unavailable")
+		return
+	}
+	for _, state := range states {
+		if err := as.SendWebsocket(ctx, &appservice.WebsocketRequest{Command: "bridge_status", Data: state}); err != nil {
+			as.Log.Warn().Msg("Failed to forward bridge account status")
+			return
+		}
+	}
+}
+
+func readLocalBridgeStatus(ctx context.Context, base, token string) ([]status.BridgeState, error) {
+	parsed, err := url.Parse(base)
+	if err != nil || parsed.Scheme != "http" || (parsed.Hostname() != "127.0.0.1" && parsed.Hostname() != "::1" && parsed.Hostname() != "localhost") {
+		return nil, errors.New("bridge status requires a loopback appservice URL")
+	}
+	fullURL := parsed.JoinPath("_threema", "bridge-state")
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, fullURL.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	client := http.Client{Timeout: 5 * time.Second, CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, errors.New("local bridge status unavailable")
+	}
+	var states []status.BridgeState
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 65536)).Decode(&states); err != nil {
+		return nil, err
+	}
+	if len(states) != 2 || states[0].RemoteID != "" || states[1].RemoteID == "" || states[1].UserID == "" {
+		return nil, errors.New("invalid local bridge states")
+	}
+	for _, state := range states {
+		if !state.StateEvent.IsValid() || state.TTL < 1 || state.TTL > 90 {
+			return nil, errors.New("invalid local bridge state lifetime")
+		}
+	}
+	return states, nil
+}
